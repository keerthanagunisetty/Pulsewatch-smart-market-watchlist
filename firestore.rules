rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PulseBed Firestore Security Rules (Role-Based)
    // =========================================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() == 'STAFF';
    }

    function isAdminOrStaff() {
      return isAuthenticated() && (getUserRole() == 'ADMIN' || getUserRole() == 'STAFF');
    }

    function isUser() {
      return isAuthenticated() && getUserRole() == 'USER';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // =========================================================================
    // Users collection
    // - Authenticated users can read their OWN profile
    // - Admins can read all user profiles
    // - Users can create their own profile (registration)
    // - Admins can update roles
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminOrStaff();
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'USER'
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
                    || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // Hospitals collection
    // - Everyone can read hospital bed availability (public info)
    // - Only Admin/Staff can create, update, or delete hospital records
    // =========================================================================
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    // =========================================================================
    // Patient Bookings collection
    // - Authenticated patients (USER role) can:
    //   - Read ONLY their own bookings (where userId == their uid)
    //   - Create booking requests (status must be 'Pending', userId must match)
    // - Admin/Staff can:
    //   - Read ALL bookings
    //   - Create, update (approve/reject/discharge), delete bookings
    // =========================================================================
    match /patientBookings/{bookingId} {
      // Admin/Staff can read all
      allow read: if isAdminOrStaff();

      // Users can read ONLY their own bookings
      allow read: if isUser() && resource.data.userId == request.auth.uid;

      // Users can create bookings for themselves (must be Pending status)
      allow create: if isUser()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.bookingStatus == 'Pending';

      // Admins/Staff can create bookings (any status) 
      allow create: if isAdminOrStaff();

      // Admins/Staff can update (approve, reject, discharge) any booking
      allow update: if isAdminOrStaff();

      // Only Admins can delete bookings
      allow delete: if isAdmin();
    }

  }
}
